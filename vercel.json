{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/src/html/about.html" },
    { "source": "/contact", "destination": "/src/html/contact.html" },
    { "source": "/app", "destination": "/src/html/app.html" },
    { "source": "/dashboard", "destination": "/src/html/dashboard.html" },
    { "source": "/notifications", "destination": "/src/html/notifications.html" },
    { "source": "/profile", "destination": "/src/html/profile.html" },
    { "source": "/settings", "destination": "/src/html/settings.html" },
    { "source": "/error", "destination": "/src/html/error.html" },
    { "source": "/Admin", "destination": "/Admin/index.html" },
    { "source": "/Admin/(.*)", "destination": "/Admin/$1" }
  ]
}
